# Copy to .env.local (never commit it). Values come from the Supabase dashboard and the API host.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable (anon) key. Never put the service-role / secret key in the frontend.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# FastAPI base URL, no trailing slash. Its FRONTEND_ORIGINS must contain this app's origin.
NEXT_PUBLIC_API_URL=https://irb-api.warwarsn.online
